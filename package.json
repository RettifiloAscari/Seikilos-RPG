{
  "name": "seikilos-rpg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A turn-based JRPG with a Chrono Trigger-style ATB battle system.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "assets:inspect": "node scripts/assets-inspect.mjs",
    "assets:import": "node scripts/assets-import.mjs",
    "assets:check": "node scripts/assets-import.mjs --check"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
